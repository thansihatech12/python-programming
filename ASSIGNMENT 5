Implement a Practical Strategy (2 Marks) Implement the assignment's lexicon scorer. The previous word's negation flips the polarity of the next recognised sentiment word. This is a transparent baseline that can be manually audited. POSITIVE = {"good", "clean", "fast", "helpful", "improved"} NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke", "broken"} NEGATORS = {"not", "never", "no"} def score(text):    words = text.lower().replace(".", " ").replace(",", " ").split()    total = 0    negate_next = False    for word in words:        if word in NEGATORS:            negate_next = not negate_next        elif word in POSITIVE:            total += -1 if negate_next else 1            negate_next = False        elif word in NEGATIVE:            total += 1 if negate_next else -1            negate_next = False    return total def label(text):    value = score(text)    return "positive" if value > 0 else "negative" if value < 0 else "neutral" complaints = [    "Roads are clean and the bus was fast.",    "Smoke from the factory, air is bad.",    "The staff were not helpful.",    "Not bad, service improved." ] for complaint in complaints:    print(label(complaint), "|", complaint)
