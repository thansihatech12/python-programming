from pathlib import Path
import csv, re

class InvalidRegistration(Exception):
    pass

def valid_email(email):
    parts=email.split("@")
    return (len(parts)==2 and bool(parts[0]) and "." in parts[1]
            and not parts[1].startswith(".") and not parts[1].endswith("."))

def parse(line):
    fields=[x.strip() for x in line.rstrip("\\n").split(";")]
    if len(fields)!=5: raise InvalidRegistration("expected 5 fields")
    reg,name,dept,email,event_text=fields
    if not all([reg,name,dept,email,event_text]):
        raise InvalidRegistration("empty required field")
    if not valid_email(email): raise InvalidRegistration("invalid email")
    events=[x.strip() for x in event_text.split(",") if x.strip()]
    if not events: raise InvalidRegistration("no event selected")
    return {"register":reg,"name":name,"department":dept,
            "email":email,"events":events}

def process(files):
    seen=set(); accepted=[]; event_map={}; errors=[]; missing=[]
    for path in map(Path,files):
        try:
            with path.open(encoding="utf-8") as f:
                for no,raw in enumerate(f,1):
                    if not raw.strip(): continue
                    try:
                        rec=parse(raw)
                        if rec["register"] in seen:
                            raise InvalidRegistration("duplicate register number")
                        seen.add(rec["register"]); accepted.append(rec)
                        for event in rec["events"]:
                            event_map.setdefault(event,[]).append(rec)
                    except InvalidRegistration as exc:
                        errors.append((path.name,no,raw.rstrip(),str(exc)))
        except FileNotFoundError:
            missing.append(path.name)
            errors.append((path.name,0,"","missing file"))
        except (PermissionError,UnicodeDecodeError,OSError) as exc:
            errors.append((path.name,0,"",f"{type(exc).__name__}: {exc}"))
    return accepted,event_map,errors,missing

def write_reports(accepted,event_map,errors,missing,out_dir):
    out=Path(out_dir); out.mkdir(parents=True,exist_ok=True)
    with (out/"master.csv").open("w",encoding="utf-8",newline="") as f:
        w=csv.writer(f); w.writerow(["register","name","department","email","events"])
        for r in accepted:
            w.writerow([r["register"],r["name"],r["department"],
                        r["email"],",".join(r["events"])])
    for event,people in event_map.items():
        safe=re.sub(r"[^A-Za-z0-9_-]","_",event)
        with (out/f"{safe}.csv").open("w",encoding="utf-8",newline="") as f:
            w=csv.writer(f); w.writerow(["register","name","department","email"])
            for r in people:
                w.writerow([r["register"],r["name"],r["department"],r["email"]])
    with (out/"errors.csv").open("w",encoding="utf-8",newline="") as f:
        w=csv.writer(f); w.writerow(["file","line","raw","reason"]); w.writerows(errors)
    with (out/"summary.txt").open("w",encoding="utf-8") as f:
        f.write(f"Accepted: {len(accepted)}\\nErrors: {len(errors)}\\nMissing files: {len(missing)}\\n")
        f.write("Missing: "+", ".join(missing)+"\\n")
        for event,people in sorted(event_map.items()):
            f.write(f"{event}: {len(people)}\\n")

if __name__=="__main__":
    inputs=[Path("input")/f"dept{i}.txt" for i in range(1,6)]
    accepted,events,errors,missing=process(inputs)
    write_reports(accepted,events,errors,missing,"output")
    print("Reports saved in output/")
