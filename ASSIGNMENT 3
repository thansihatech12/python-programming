Implement and Measure (3 marks) import random, re, time TITLES = {"dr", "mr", "mrs", "ms", "prof", "shri", "smt", "sri"} def norm_phone(raw):    """Keep digits only; if more than 10 digits keep the last 10 (drops +91 / 91 / leading 0).    Returns None when fewer than 10 digits remain (cannot be matched safely)."""    digits = re.sub(r"\D", "", raw or "")    digits = digits[-10:] if len(digits) > 10 else digits    return digits if len(digits) == 10 else None def norm_email(raw):    raw = (raw or "").strip().lower()    return raw if "@" in raw else None def norm_name(raw):    tokens = re.sub(r"[^a-z\s]", " ", (raw or "").lower()).split()    return " ".join(t for t in tokens if t not in TITLES) def merge_contacts(contacts):    """contacts: list of dicts {name, phones:[...], emails:[...]}.    index : normalised number / e-mail -> group id   (dictionary lookup, O(1) average)    groups: group id -> {'names': set, 'numbers': set, 'emails': set}"""    index, groups, next_id, loose = {}, {}, 0, []    for c in contacts:        nums = {n for n in map(norm_phone, c.get("phones", [])) if n}        mails = {m for m in map(norm_email, c.get("emails", [])) if m}        name = norm_name(c.get("name", ""))        keys = [("p", n) for n in nums] + [("e", m) for m in mails]        if not keys:                                # no phone and no e-mail: cannot be matched safely            loose.append(c); continue        hit = sorted({index[k] for k in keys if k in index})        if not hit:            gid = next_id; next_id += 1            groups[gid] = {"names": set(), "numbers": set(), "emails": set()}        else:            gid = hit[0]            for other in hit[1:]:                   # this contact links two existing people -> merge them                g = groups.pop(other)                for k in g["numbers"]: index[("p", k)] = gid                for k in g["emails"]: index[("e", k)] = gid                for field in ("names", "numbers", "emails"): groups[gid][field] |= g[field]        g = groups[gid]        if name: g["names"].add(name)        g["numbers"] |= nums; g["emails"] |= mails        for k in keys: index[k] = gid    return groups, loose def display(groups):    rows = []    for g in groups.values():        rows.append((max(g["names"], key=len).title() if g["names"] else "(no name)", sorted(g["numbers"]),              sorted(g["emails"])))    return sorted(rows) def merge_pairwise(contacts):    """Baseline: compare EVERY pair of contacts, O(n^2), union-find only to keep results comparable."""    keys = []    for c in contacts:        s = {("p", n) for n in map(norm_phone, c.get("phones", [])) if n} | {("e", m) for m in map(norm_email,              c.get("emails", [])) if m}        keys.append(s)    parent = list(range(len(contacts)))    def find(x):        while parent[x] != x: parent[x] = parent[parent[x]]; x = parent[x]
return x    for i in range(len(contacts)):        for j in range(i + 1, len(contacts)):            if keys[i] & keys[j]: parent[find(i)] = find(j)    return len({find(i) for i in range(len(contacts)) if keys[i]}) # ---------- test data ---------FORMATS = ["+91 {a} {b}", "{a}{b}", "0{a}{b}", "{a}-{b}", "+91-{a}{b}", "({a}) {b}"] def fmt_phone(num10, rng):    return rng.choice(FORMATS).format(a=num10[:5], b=num10[5:]) def make_contacts(n, seed=21):    rng = random.Random(seed); people = max(1, n // 3)    pool = [{"nums": [str(rng.randrange(7_000_000_000, 10_000_000_000)) for _ in range(rng.choice([1, 1, 2]))],             "mail": f"user{p}@mail.com", "first": rng.choice(["ravi", "anita", "kumar", "meena", "suresh"]), "last":                   rng.choice(["kumar", "iyer", "raj", "devi", "nair"])} for p in range(people)]    out = []    for _ in range(n):        p = rng.choice(pool)        name = rng.choice([f"{p['first']} {p['last']}", f"Dr. {p['first'].title()}", f"{p['first'].upper()}              {p['last']}", p["first"].title()])        phones = [fmt_phone(x, rng) for x in rng.sample(p["nums"], rng.randint(1, len(p["nums"])))]        out.append({"name": name, "phones": phones, "emails": [p["mail"].upper()] if rng.random() < 0.3 else []})    return out if __name__ == "__main__":    print("norm_phone:", [norm_phone(x) for x in ["+91 98400 12345", "9840012345", "09840012345", "98400-12345",          "12345", ""]])    print("norm_name :", [norm_name(x) for x in ["Dr. Ravi", "  ravi   kumar ", "MRS. Anita  Iyer"]])    hand = [        {"name": "Dr. Ravi",    "phones": ["+91 98400 12345"], "emails": []},                              # phone 1        {"name": "ravi kumar",  "phones": ["9840012345", "94444 00001"], "emails": ["Ravi@Mail.com"]},  # same person +              2nd number + mail        {"name": "Anita",       "phones": ["09500011111"], "emails": []},        {"name": "Ravi Kumar",  "phones": ["98765 43210"], "emails": []},                               # DIFFERENT              person, same name        {"name": "Anita Iyer",  "phones": ["+91 9500011111"], "emails": ["anita@x.com"]},               # same as Anita        {"name": "No Number",   "phones": [], "emails": []},                                              # missing              fields        {"name": "Meena",       "phones": ["12345"], "emails": ["meena@x.com"]},                         # short/invalid              number, e-mail still matches        {"name": "meena nair",  "phones": [], "emails": ["MEENA@x.com "]},    ]    groups, loose = merge_contacts(hand)    print("\nhand-merged input: 8 contacts ->", len(groups), "people +", len(loose), "unmatchable")    for row in display(groups): print("  ", row)    print("   unmatchable:", [c["name"] for c in loose])    expected = [("Anita Iyer", ["9500011111"], ["anita@x.com"]),                ("Meena Nair", [], ["meena@x.com"]),                ("Ravi Kumar", ["9444400001", "9840012345"], ["ravi@mail.com"]),                ("Ravi Kumar", ["9876543210"], [])]    print("matches hand-worked answer:", display(groups) == sorted(expected))    print("\n-- timing --")    print(f"{'contacts':>9} {'dict merge (s)':>15} {'people':>8} {'pairwise (s)':>13} {'same people':>12}")    for n in (1000, 2000, 4000):        cs = make_contacts(n)        t0 = time.perf_counter(); g, _ = merge_contacts(cs); t_d = time.perf_counter() - t0        t0 = time.perf_counter(); p = merge_pairwise(cs); t_p = time.perf_counter() - t0        print(f"{n:>9} {t_d:>15.5f} {len(g):>8} {t_p:>13.4f} {str(len(g) == p):>12}")        last_p = (n, t_p)    for n in (100_000,):        cs = make_contacts(n)        t0 = time.perf_counter(); g, _ = merge_contacts(cs); t_d = time.perf_counter() - t0        est = last_p[1] * (n / last_p[0]) ** 2        print(f"{n:>9} {t_d:>15.5f} {len(g):>8} {'~%.0f (est.)' % est:>13} {'n/a':>12}")    print("(pairwise at 100,000 not run: ~5 billion comparisons; estimated by scaling the 4,000 measurement by          (100000/4000)^2)")    pr